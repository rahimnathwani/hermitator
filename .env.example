# Local settings for `make deploy` and `make dev`. Copy to .env, which git
# ignores.

# SSH destination of the host to install on (an ~/.ssh/config alias works).
DEPLOY_HOST=root@203.0.113.10
# Domain whose A/AAAA records point at the host; Caddy fetches a certificate.
DEPLOY_DOMAIN=hermitator.example.com
# Set to 1 to build whisper.cpp on the host for voice note transcription.
WITH_WHISPER=1

# Server-side configuration lives in /etc/hermitator/hermitator.env on the
# host, written by deploy/install.sh. The variables it understands:
#
#   HERMITATOR_MASTER_KEY      required; `hermitator keygen` makes one
#   HERMITATOR_PUBLIC_URL      where users reach the panel
#   HERMITATOR_LISTEN          default 127.0.0.1:8080
#   HERMITATOR_DATA_DIR        default /var/lib/hermitator
#   HERMITATOR_RUNTIME         runsc (default) or unsafe-local for development
#   HERMITATOR_RUNSC           path to runsc, default from $PATH
#   HERMITATOR_RUNSC_PLATFORM  systrap (default), kvm or ptrace
#   HERMITATOR_SUBNET          agent network, default 10.231.0.0/16
#   HERMITATOR_BRIDGE          bridge name, default hermitator0
#   HERMITATOR_WHISPER         whisper-cli binary
#   HERMITATOR_WHISPER_MODEL   default $DATA_DIR/whisper/ggml-small.bin
#   HERMITATOR_LOG             debug, info (default), warn or error
