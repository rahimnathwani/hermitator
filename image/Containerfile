# The "universal" agent image.
#
# hermitator does not run this as a container. deploy/build-image.sh exports
# the resulting filesystem into a directory that every agent sandbox uses as
# a read-only OverlayFS lower layer. Anything an agent installs later lands in
# that agent's own upper layer.

FROM docker.io/library/ubuntu:24.04

ARG NODE_MAJOR=22
ARG CLAUDE_CODE_VERSION=2.1.302
ARG PI_VERSION=1.3.0
ARG PLAYWRIGHT_VERSION=1.64.1
# Must use the same browser build as the Node package above.
ARG PLAYWRIGHT_PYTHON_VERSION=1.64.0
# Antigravity's CLI is a single binary from Google's release bucket, which
# names only its latest build, so the build is pinned by URL and SHA-512.
# internal/imageupdate moves it a day after Google published it.
ARG AGY_VERSION=1.5.14
ARG AGY_URL=https://storage.googleapis.com/antigravity-public/antigravity-cli/1.5.14-5302690847260672/linux-x64/cli_linux_x64.tar.gz
ARG AGY_SHA512=83311d3f354567612dc16c1ae2ea9b503d6f6833aa4e138d39aa229da3f3bb99b0e4d7cca0bce4796b0060d6a51d8113eb7449ed5dc0e7900bf217107ea5bff9
# npm and uv install nothing published after this, dependencies included;
# deploy/bump-image.sh sets it a week back when it moves the pins.
ARG RELEASED_BEFORE=2026-10-18T01:00:47.000Z

ENV DEBIAN_FRONTEND=noninteractive \
    LANG=C.UTF-8 \
    LC_ALL=C.UTF-8 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    AGY_CLI_DISABLE_AUTO_UPDATE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
      build-essential ca-certificates curl dnsutils fd-find ffmpeg file git gnupg \
      htop imagemagick iproute2 iputils-ping jq less nano openssh-client procps \
      psmisc python3 python3-pip python3-venv ripgrep sqlite3 sudo tini tmux \
      tzdata unzip vim-tiny wget xz-utils zip \
 && ln -s /usr/bin/fdfind /usr/local/bin/fd \
 && rm -rf /var/lib/apt/lists/*

# Node.js from NodeSource; Ubuntu's is too old for current CLIs.
RUN curl -fsSL https://deb.nodesource.com/setup_${NODE_MAJOR}.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && rm -rf /var/lib/apt/lists/*

# GitHub CLI.
RUN install -d -m 0755 /etc/apt/keyrings \
 && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      -o /etc/apt/keyrings/githubcli-archive-keyring.gpg \
 && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
 && apt-get update && apt-get install -y --no-install-recommends gh \
 && rm -rf /var/lib/apt/lists/*

# uv for Python work.
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR=/usr/local/bin UV_NO_MODIFY_PATH=1 sh

# Claude Code and pi, plus pnpm.
RUN npm_config_before=${RELEASED_BEFORE} npm install -g --no-fund --no-audit \
      @anthropic-ai/claude-code@${CLAUDE_CODE_VERSION} \
      @earendil-works/pi-coding-agent@${PI_VERSION} \
      pnpm \
 && npm cache clean --force

# Antigravity (agy), checked against the pinned SHA-512. Its own updater
# is off (AGY_CLI_DISABLE_AUTO_UPDATE above): image upgrades move it. The
# pin is the amd64 build, so other machines go without.
RUN if [ "$(uname -m)" = x86_64 ]; then \
      curl -fsSL "${AGY_URL}" -o /tmp/agy.tar.gz \
   && echo "${AGY_SHA512}  /tmp/agy.tar.gz" | sha512sum -c - \
   && tar -xzf /tmp/agy.tar.gz -C /tmp antigravity \
   && install -m 0755 /tmp/antigravity /usr/local/bin/agy \
   && rm -f /tmp/agy.tar.gz /tmp/antigravity \
   && agy --version; \
    fi

# Headless Chromium for screenshots and browser automation. Playwright
# passes --no-sandbox by default; the wrapper below covers everything else
# that execs a "chromium" binary directly.
RUN npm_config_before=${RELEASED_BEFORE} npx -y playwright@${PLAYWRIGHT_VERSION} install --with-deps chromium \
 && npm_config_before=${RELEASED_BEFORE} npm install -g --no-fund --no-audit playwright@${PLAYWRIGHT_VERSION} \
 && npm cache clean --force \
 && rm -rf /var/lib/apt/lists/*

# Python Playwright, sharing the browsers installed above. The check fails
# the build if it ever expects a different browser build.
RUN uv pip install --system --break-system-packages --no-cache --exclude-newer ${RELEASED_BEFORE} playwright==${PLAYWRIGHT_PYTHON_VERSION} \
 && python3 -c "from playwright.sync_api import sync_playwright; p = sync_playwright().start(); p.chromium.launch().close(); p.stop()"

COPY rootfs/ /

RUN chmod 0755 /usr/local/bin/chromium \
 && mkdir -p /workspace /shared/inbox /shared/outbox \
 && git config --system init.defaultBranch main \
 && git config --system safe.directory '*'

WORKDIR /workspace
